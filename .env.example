# ---------------------------------------------------------------
# Task Management System - environment variables
# Copy this file to .env and adjust the values.
# Never commit the real .env file (it is listed in .gitignore).
# ---------------------------------------------------------------

# HTTP port used by the Express server
PORT=3000

# Secret used to sign the login token (JWT). Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Set to true when the app is served through HTTPS (CloudFront),
# so the login cookie is only sent over encrypted connections.
COOKIE_SECURE=false

# ---- Amazon RDS (MySQL) ----
# Locally, docker-compose starts a MySQL container with these values.
DB_HOST=localhost
DB_PORT=3306
DB_USER=taskapp
DB_PASSWORD=taskapp-password
DB_NAME=taskdb

# ---- Amazon S3 ----
# Leave S3_BUCKET empty to store attachments on the local disk (./uploads).
AWS_REGION=us-east-1
S3_BUCKET=

# ---- Amazon CloudWatch ----
# true = publish custom application metrics (TasksCreated, TasksCompleted...)
CLOUDWATCH_METRICS=false
CLOUDWATCH_NAMESPACE=TaskManagementSystem

# Where application logs are written (the CloudWatch agent reads this file)
LOG_FILE=logs/app.log
